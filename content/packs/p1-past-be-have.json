        {"id": "p1-be-04", "type": "pick", "pic": "🏷️", "text": "Her name ___ Rosie.", "options": ["is", "are"], "answer": "is", "who": "one", "subject": "Her name", "hint": "Look: Her name. How many names? Just one!"},
