{
  "id": "p1",
  "title": "Simple Past, Be and Have",
  "pic": "🎒",
  "objectives": [
    {"id": "p1-o1", "text": "Change action words from now to before"},
    {"id": "p1-o2", "text": "Spell -ed words the right way"},
    {"id": "p1-o3", "text": "Remember the special past words"},
    {"id": "p1-o4", "text": "Use time clues: yesterday, last week, just now"},
    {"id": "p1-o5", "text": "Choose am, is, are and has, have"}
  ],
  "units": [
    {
